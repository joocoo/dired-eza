(require 'ert)
(require 'cl-lib)
(require 'dired-eza)
(require 'ls-lisp)
(require 'tramp)

(defun dired-eza-test--style (text key)
  (cdr (assoc key (dired-eza-colors-types (dired-eza-colors-parse text)))))

(defmacro dired-eza-test--buffer (&rest body)
  (declare (indent 0) (debug t))
  `(with-temp-buffer
     (dired-mode default-directory "-al")
     (let ((inhibit-read-only t))
       (insert "  /fixture:\n  total 0\n")
       (dolist (row '(("drwxr-xr-x" "directory") ("-rw-r--r--" "notes.txt")
                      ("-rwxr-xr-x" "script.txt") ("lrwxrwxrwx" "link.txt")))
         (insert "  " (car row) " 1 owner group 123 Oct 15 12:00 ")
         (insert (propertize (cadr row) 'dired-filename t))
         (when (equal (car row) "lrwxrwxrwx") (insert " -> notes.txt"))
         (insert "\n")))
     (setq-local dired-subdir-alist (list (cons default-directory (copy-marker 1))))
     (set-buffer-modified-p nil)
     (setq-local dired-eza-ls-colors "di=34:*.txt=31:ln=36:ex=32")
     (setq-local dired-eza-eza-colors "")
     (setq-local dired-eza-user-identities '("owner" "1000"))
     (setq-local dired-eza-group-identities '("group" "100"))
     (goto-char (point-min))
     ,@body))

(defun dired-eza-test--face (name)
  (save-excursion
    (goto-char (point-min))
    (search-forward name)
    (get-text-property (1- (point)) 'face)))

(defun dired-eza-test--foreground (name)
  (let ((face (dired-eza-test--face name)))
    (cl-loop for item in (if (listp face) face (list face))
             when (and (listp item) (plist-member item :foreground))
             return (plist-get item :foreground))))

(ert-deftest dired-eza-colors-empty-and-duplicates ()
  (should-not (dired-eza-colors-types (dired-eza-colors-parse nil)))
  (should (equal (dired-eza-test--style ":di=31:di=34:di=bad::" "di")
                 '(:foreground "#000080")))
  (should (equal (dired-eza-test--style "di=" "di") dired-eza-colors--reset)))

(ert-deftest dired-eza-colors-escaped-delimiters ()
  (let ((colors (dired-eza-colors-parse "*a\\:b=31:*c\\=d=32:*e\\\\f=34")))
    (should (equal (dired-eza-colors-suffix colors "za:b") '(:foreground "#800000")))
    (should (equal (dired-eza-colors-suffix colors "zc=d") '(:foreground "#008000")))
    (should (equal (dired-eza-colors-suffix colors "ze\\f") '(:foreground "#000080")))))

(ert-deftest dired-eza-colors-numeric-and-control-escapes ()
  (should (equal (dired-eza-colors--unescape "a\\072b\\x3d!") "a:b=!"))
  (should (equal (dired-eza-colors--unescape "^A\\e\\_\\?") (string 1 27 32 127)))
  (should-not (dired-eza-colors--unescape "bad\\"))
  (should-not (dired-eza-colors--unescape "bad^"))
  (should-not (dired-eza-colors--unescape "bad\\x")))

(ert-deftest dired-eza-colors-suffix-order-and-literal-semantics ()
  (let ((colors (dired-eza-colors-parse "*.tar.gz=31:*.gz=32:*a?b=34")))
    (should (equal (dired-eza-colors-suffix colors "x.tar.gz") '(:foreground "#008000")))
    (should-not (dired-eza-colors-suffix colors "xaab"))
    (should (dired-eza-colors-suffix colors "xa?b"))))

(ert-deftest dired-eza-colors-suffix-case-collisions ()
  (should (dired-eza-colors-suffix (dired-eza-colors-parse "*.jpg=31") "X.JPG"))
  (let ((colors (dired-eza-colors-parse "*.jpg=31:*.JPG=32")))
    (should (equal (dired-eza-colors-suffix colors "x.JPG") '(:foreground "#008000")))
    (should-not (dired-eza-colors-suffix colors "x.Jpg")))
  (should (dired-eza-colors-suffix
           (dired-eza-colors-parse "*.jpg=31:*.JPG=32:*.jpg=32") "x.Jpg")))

(ert-deftest dired-eza-colors-sgr-palette ()
  (should (equal (dired-eza-colors-sgr "01;94;103")
                 '(:weight bold :foreground "#0000ff" :background "#ffff00")))
  (should (equal (dired-eza-colors-sgr "38;5;196;48;5;232")
                 '(:foreground "#ff0000" :background "#080808")))
  (should (equal (dired-eza-colors-sgr "38;2;1;2;255") '(:foreground "#0102ff")))
  (should (equal (dired-eza-colors-sgr "48;2;20;30;40") '(:background "#141e28"))))

(ert-deftest dired-eza-colors-sgr-resets ()
  (let ((style (dired-eza-colors-sgr "1;3;4;7;9;22;23;24;27;29;39;49")))
    (should (eq (plist-get style :weight) 'normal))
    (should (eq (plist-get style :slant) 'normal))
    (should-not (plist-get style :underline))
    (should-not (plist-get style :inverse-video))
    (should-not (plist-get style :strike-through)))
  (should (equal (dired-eza-colors-sgr "31;0") dired-eza-colors--reset))
  (should (equal (plist-get (dired-eza-colors-sgr "31;0;32") :foreground) "#008000")))

(ert-deftest dired-eza-colors-reject-malformed-and-control-payloads ()
  (dolist (s '("38" "38;5" "38;5;256" "38;2;1;2" "48;2;-1;0;0"
               "31hello" "\e[31m" "(progn (error x))"))
    (should-not (dired-eza-colors-sgr s)))
  (let ((colors (dired-eza-colors-parse "lc=\\e[:rc=m:di=bad:wat=31:ln=target:fi=32")))
    (should (= (length (dired-eza-colors-types colors)) 1)))
  (should (dired-eza-colors-sgr "5;6;8;999")))

(ert-deftest dired-eza-classify-types-and-precedence ()
  (let ((colors (dired-eza-colors-parse
                 "di=34:ln=36:fi=37:ex=32:su=35:sg=33:tw=31:ow=32:st=33:*.txt=91")))
    (dolist (case '(("drwxr-xr-x" . "di") ("lrwxrwxrwx" . "ln")
                    ("prw-r--r--" . "pi") ("srwxr-xr-x" . "so")
                    ("brw-r--r--" . "bd") ("crw-r--r--" . "cd")
                    ("-rwxr-xr-x" . "ex") ("-rwsr-sr-x" . "su")
                    ("-rwSr--r--" . "su") ("-rwxr-Sr-x" . "sg")
                    ("drwxrwxrwt" . "tw") ("drwxrwxrwT" . "tw")
                    ("drwxrwxrwx" . "ow") ("drwxr-xr-t" . "st")))
      (should (equal (cdr (dired-eza-classify colors "a.txt" (car case))) (cdr case))))))

(ert-deftest dired-eza-classify-suffix-fallbacks-and-resets ()
  (let ((colors (dired-eza-colors-parse "ex=0:*.txt=31:fi=32:di=")))
    (should (equal (car (dired-eza-classify colors "x.txt" "-rwxr-xr-x"))
                   '(:foreground "#800000")))
    (should (equal (car (dired-eza-classify colors "x.txt" "drwxr-xr-x"))
                   dired-eza-colors--reset)))
  (should (equal (car (dired-eza-classify (dired-eza-colors-parse "no=33")
                                       "x" "-rw-r--r--")) '(:foreground "#808000"))))

(ert-deftest dired-eza-font-lock-filename-boundaries ()
  (dired-eza-test--buffer
    (let ((before (buffer-string)) (keymap (current-local-map)))
      (dired-eza-mode 1)
      (font-lock-ensure)
      (should (equal (dired-eza-test--foreground "directory") "#000080"))
      (should (equal (dired-eza-test--foreground "notes.txt") "#800000"))
      (should (equal (dired-eza-test--foreground "script.txt") "#008000"))
      (should (equal (dired-eza-test--foreground "link.txt") "#008080"))
      (should-not (dired-eza-test--foreground "-> notes.txt"))
      (should (equal before (buffer-string)))
      (should (eq keymap (current-local-map)))
      (should-not (buffer-modified-p)))))

(ert-deftest dired-eza-preserves-marks-and-deletion-faces ()
  (dired-eza-test--buffer
    (goto-char (point-min)) (search-forward "notes.txt") (dired-mark 1)
    (goto-char (point-min)) (search-forward "script.txt") (dired-flag-file-deletion 1)
    (dired-eza-mode 1) (font-lock-ensure)
    (should (memq 'dired-marked (ensure-list (dired-eza-test--face "notes.txt"))))
    (should (memq 'dired-flagged (ensure-list (dired-eza-test--face "script.txt")) ))
    (should-not (dired-eza-test--foreground "notes.txt"))))

(ert-deftest dired-eza-mode-disable-and-refresh ()
  (dired-eza-test--buffer
    (dired-eza-mode 1) (dired-eza-mode 1) (font-lock-ensure)
    (should (= (cl-count (car dired-eza--keywords) font-lock-keywords :test #'equal) 1))
    (setq-local dired-eza-ls-colors "*.txt=34")
    (dired-eza-refresh) (font-lock-ensure)
    (should (equal (dired-eza-test--foreground "notes.txt") "#000080"))
    (dired-eza-mode -1) (font-lock-ensure)
    (should-not (dired-eza-test--foreground "notes.txt"))
    (should-not (member (car dired-eza--keywords) font-lock-keywords))))

(ert-deftest dired-eza-environment-inheritance ()
  (dired-eza-test--buffer
    (let ((process-environment (copy-sequence process-environment)))
      (setenv "LS_COLORS" "di=35")
      (setq-local dired-eza-ls-colors nil)
      (dired-eza-mode 1) (font-lock-ensure)
      (should (equal (dired-eza-test--foreground "directory") "#800080"))
      (setq-local dired-eza-ls-colors "")
      (dired-eza-refresh) (font-lock-ensure)
      (should (memq 'dired-eza-directory (ensure-list (dired-eza-test--face "directory")))))))

(ert-deftest dired-eza-hide-details-preserved ()
  (dired-eza-test--buffer
    (dired-hide-details-mode 1)
    (let ((spec (copy-tree buffer-invisibility-spec)))
      (dired-eza-mode 1) (font-lock-ensure)
      (should (equal spec buffer-invisibility-spec))
      (should dired-hide-details-mode)
      (should (equal (dired-eza-test--foreground "notes.txt") "#800000"))
      (dired-eza-mode -1) (font-lock-ensure)
      (should (equal spec buffer-invisibility-spec)))))

(ert-deftest dired-eza-no-io-even-with-remote-default-directory ()
  (dired-eza-test--buffer
    (setq default-directory "/ssh:unreachable.invalid:/directory/")
    ;; Native Dired can itself stat symlinks.  Isolate the mode's added work.
    (setq-local dired-check-symlinks nil)
    (let ((native-comp-enable-subr-trampolines nil))
     (cl-letf (((symbol-function 'file-attributes) (lambda (&rest _) (ert-fail "stat")))
              ((symbol-function 'file-exists-p) (lambda (&rest _) (ert-fail "exists")))
              ((symbol-function 'file-directory-p) (lambda (&rest _) (ert-fail "directory")))
              ((symbol-function 'file-symlink-p) (lambda (&rest _) (ert-fail "symlink")))
              ((symbol-function 'process-file) (lambda (&rest _) (ert-fail "process-file")))
              ((symbol-function 'call-process) (lambda (&rest _) (ert-fail "call-process")))
              ((symbol-function 'start-process) (lambda (&rest _) (ert-fail "start-process"))))
      (dired-eza-mode 1) (font-lock-ensure)
      (should (equal (dired-eza-test--foreground "notes.txt") "#800000"))
      (dired-eza-refresh) (font-lock-ensure)
      (dired-eza-mode -1) (font-lock-ensure)))))

(ert-deftest dired-eza-requires-dired ()
  (with-temp-buffer
    (should-error (dired-eza-mode 1) :type 'user-error)
    (should-not dired-eza-mode)
    (should-error (dired-eza-refresh) :type 'user-error)))

(ert-deftest dired-eza-listings-without-filename-properties ()
  (dired-eza-test--buffer
    (let ((inhibit-read-only t))
      (remove-text-properties (point-min) (point-max) '(dired-filename nil)))
    (dired-eza-mode 1) (font-lock-ensure)
    (should (equal (dired-eza-test--foreground "notes.txt") "#800000"))
    (should (equal (dired-eza-test--foreground "directory") "#000080"))
    (should (equal (dired-eza-test--foreground "link.txt") "#008080"))))

(ert-deftest dired-eza-classification-indicators-excluded ()
  (dired-eza-test--buffer
    (let ((inhibit-read-only t))
      (goto-char (point-min)) (search-forward "script.txt") (insert "*")
      (goto-char (point-min)) (search-forward "directory") (insert "/")
      (remove-text-properties (point-min) (point-max) '(dired-filename nil)))
    (setq-local dired-actual-switches "-alF")
    (setq-local dired-eza-ls-colors "*.txt=31:di=34")
    (dired-eza-mode 1) (font-lock-ensure)
    (should (equal (dired-eza-test--foreground "script.txt") "#800000"))
    (should-not (dired-eza-test--foreground "script.txt*"))
    (should-not (dired-eza-test--foreground "directory/"))))

(ert-deftest dired-eza-hidden-rows-remain-hidden ()
  (dired-eza-test--buffer
    (let ((inhibit-read-only t))
      (goto-char (point-min)) (search-forward "notes.txt")
      (put-text-property (line-beginning-position) (line-end-position) 'invisible 'dired))
    (dired-eza-mode 1) (font-lock-ensure)
    (should-not (dired-eza-test--foreground "notes.txt"))
    (goto-char (point-min)) (search-forward "notes.txt")
    (should (eq (get-text-property (1- (point)) 'invisible) 'dired))))

(ert-deftest dired-eza-multiline-and-unicode-filename ()
  (dired-eza-test--buffer
    (let ((inhibit-read-only t))
      (goto-char (point-max))
      (insert "  -rw-r--r-- 1 owner group 42 Oct 15 12:00 ")
      (insert (propertize "日本語\nline.txt" 'dired-filename t))
      (insert "\n"))
    (dired-eza-mode 1) (font-lock-ensure)
    (should (equal (dired-eza-test--foreground "日本語") "#800000"))
    (should (equal (dired-eza-test--foreground "line.txt") "#800000"))))

(ert-deftest dired-eza-global-keywords-unchanged ()
  (let ((original (copy-tree dired-font-lock-keywords)))
    (dired-eza-test--buffer (dired-eza-mode 1) (font-lock-ensure) (dired-eza-mode -1))
    (should (equal original dired-font-lock-keywords))))

(ert-deftest dired-eza-native-ls-lisp-and-revert ()
  (let* ((dir (make-temp-file "dired-eza-test-" t))
         (file (expand-file-name "a file.txt" dir))
         (ls-lisp-use-insert-directory-program nil)
         buffer)
    (unwind-protect
        (progn
          (write-region "test" nil file nil 'silent)
          (setq buffer (dired-noselect dir "-al"))
          (with-current-buffer buffer
            (setq-local dired-eza-ls-colors "*.txt=31")
            (dired-eza-mode 1) (font-lock-ensure)
            (should (equal (dired-eza-test--foreground "a file.txt") "#800000"))
            (revert-buffer nil t) (font-lock-ensure)
            (should dired-eza-mode)
            (should (equal (dired-eza-test--foreground "a file.txt") "#800000"))
            (goto-char (point-min)) (search-forward "a file.txt")
            (should (equal (dired-get-filename) file))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory dir t))))

(defun dired-eza-test--permission-face (filename index)
  (save-excursion
    (goto-char (point-min))
    (search-forward filename)
    (beginning-of-line)
    (forward-char (+ 2 index))
    (get-text-property (point) 'face)))

(ert-deftest dired-eza-permissions-parse-separate-namespace ()
  (let ((rules (dired-eza-permissions-parse "ur=31:ur=32:ur=bad:tw=33:su=34:di=35:*.el=36")))
    (should (= (length rules) 3))
    (should (equal (cdr (assoc "ur" rules)) '(:foreground "#008000")))
    (should-not (assoc "di" rules)))
  (should (equal (cdr (assoc "ur" (dired-eza-permissions-parse "ur=")))
                 dired-eza-colors--reset))
  (let ((rules (dired-eza-permissions-parse "ur=31:reset:uw=32")))
    (should (equal (cdr (assoc "ur" rules)) dired-eza-colors--reset))
    (should (equal (cdr (assoc "uw" rules)) '(:foreground "#008000")))))

(ert-deftest dired-eza-permissions-nine-independent-bits ()
  (let* ((keys '("ur" "uw" "ux" "gr" "gw" "gx" "tr" "tw" "tx"))
         (rules (cl-loop for key in keys for n from 1
                         collect (cons key (list :foreground (format "color%d" n))))))
    (cl-loop for index from 1 to 9 do
             (should (equal (plist-get (car (dired-eza-permissions-face rules "-rwxrwxrwx" index))
                                       :foreground)
                            (format "color%d" index))))
    (should (eq (dired-eza-permissions-face rules "drwxrwxrwx" 3)
                'dired-eza-permission-execute))
    (push '("ue" . (:foreground "other")) rules)
    (should (equal (car (dired-eza-permissions-face rules "drwxrwxrwx" 3))
                   '(:foreground "other")))))

(ert-deftest dired-eza-permissions-special-and-absent-bits ()
  (let ((rules (dired-eza-permissions-parse "su=31:sf=32:xx=33:xa=34")))
    (dolist (index '(3 6 9))
      (should (equal (car (dired-eza-permissions-face rules "-rwSrwSrwT" index))
                     '(:foreground "#800000")))
      (should (equal (car (dired-eza-permissions-face rules "drwsrwsrwt" index))
                     '(:foreground "#008000"))))
    (should (equal (car (dired-eza-permissions-face rules "----------" 7))
                   '(:foreground "#808000")))
    (should (equal (car (dired-eza-permissions-face rules "-rwxrwxrwx+" 10))
                   '(:foreground "#000080")))))

(ert-deftest dired-eza-permissions-theme-fallbacks ()
  (should (eq (dired-eza-permissions-face nil "-rwxr-xr-x" 1) 'dired-eza-permission-read))
  (should (eq (dired-eza-permissions-face nil "-rwxr-xr-x" 2) 'dired-eza-permission-write))
  (should (eq (dired-eza-permissions-face nil "-rwxr-xr-x" 3) 'dired-eza-permission-execute))
  (should (eq (dired-eza-permissions-face nil "-rwxr-xr-x" 5) 'dired-eza-permission-missing)))

(ert-deftest dired-eza-permissions-native-font-lock-and-disable ()
  (dired-eza-test--buffer
    (setq-local dired-eza-eza-colors "ur=31:uw=32:ux=33:xx=34")
    (dired-eza-mode 1) (font-lock-ensure)
    (cl-loop for index in '(1 2 3 5)
             for color in '("#800000" "#008000" "#808000" "#000080") do
             (should (equal (plist-get (car (dired-eza-test--permission-face "script.txt" index))
                                       :foreground) color)))
    (should (equal (dired-eza-test--foreground "script.txt") "#008000"))
    (dired-eza-mode -1) (font-lock-ensure)
    (should-not (dired-eza-test--permission-face "script.txt" 1))))

(ert-deftest dired-eza-permissions-attribute-and-prefixes ()
  (dired-eza-test--buffer
    (let ((inhibit-read-only t))
      (goto-char (point-max))
      (insert "  1234 8 -rwxrwxrwx@ 1 owner group 42 Oct 15 12:00 ")
      (insert (propertize "prefixed" 'dired-filename t))
      (insert "\n"))
    (setq-local dired-eza-eza-colors "xa=35:ur=31")
    (dired-eza-mode 1) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "-rwxrwxrwx@")
    (should (equal (plist-get (car (get-text-property (1- (point)) 'face)) :foreground)
