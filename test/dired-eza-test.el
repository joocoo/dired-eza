(ert-deftest dired-eza-permissions-preserve-hide-details-and-marks ()
  (dired-eza-test--buffer
    (goto-char (point-min)) (search-forward "notes.txt") (dired-mark 1)
    (let ((inhibit-read-only t))
      (dired-insert-set-properties (point-min) (point-max)))
    (dired-hide-details-mode 1)
    (dired-eza-mode 1) (font-lock-ensure)
    (should (memq 'dired-eza-permission-read
                  (ensure-list (dired-eza-test--permission-face "notes.txt" 1))))
    (should (memq 'dired-marked (ensure-list (dired-eza-test--face "notes.txt"))))
    (goto-char (point-min)) (search-forward "notes.txt") (beginning-of-line) (forward-char 3)
    (should (invisible-p (point)))))

(ert-deftest dired-eza-permissions-do-not-match-filename-text ()
  (dired-eza-test--buffer
    (let ((inhibit-read-only t))
      (goto-char (point-max))
      (insert "  -rw-r--r-- 1 owner group 42 Oct 15 12:00 ")
      (insert (propertize "-rwxrwxrwx.txt" 'dired-filename t))
      (insert "\n"))
    (dired-eza-mode 1) (font-lock-ensure)
    (should (equal (dired-eza-test--foreground "-rwxrwxrwx.txt") "#800000"))))

(ert-deftest dired-eza-permissions-environment-and-refresh ()
  (dired-eza-test--buffer
    (let ((process-environment (copy-sequence process-environment)))
      (setq-local dired-eza-eza-colors nil)
      (setenv "EZA_COLORS" nil) (setenv "EXA_COLORS" "ur=31")
      (dired-eza-mode 1)
      (should (equal (cdr (assoc "ur" dired-eza--permission-rules)) '(:foreground "#800000")))
      (setenv "EZA_COLORS" "") (dired-eza-refresh)
      (should-not dired-eza--permission-rules)
      (setenv "EZA_COLORS" "ur=32") (dired-eza-refresh)
      (should (equal (cdr (assoc "ur" dired-eza--permission-rules)) '(:foreground "#008000")))
      (setq-local dired-eza-eza-colors "ur=34") (dired-eza-refresh)
      (should (equal (cdr (assoc "ur" dired-eza--permission-rules)) '(:foreground "#000080"))))))

(defun dired-eza-test--size-row (name size &optional date prefix permissions owners)
  (let ((inhibit-read-only t))
    (goto-char (point-max))
    (insert (or prefix "  ") (or permissions "-rw-r--r--")
            (or owners " 1 owner group ") size " " (or date "Oct 15 12:00") " ")
    (insert (propertize name 'dired-filename t))
    (insert "\n")))

(defun dired-eza-test--size-face (filename size &optional offset)
  (save-excursion
    (goto-char (point-min)) (search-forward filename) (beginning-of-line)
    (search-forward (concat " " size " ") (line-end-position))
    (get-text-property (+ (- (point) 1 (length size)) (or offset 0)) 'face)))

(ert-deftest dired-eza-size-raw-boundaries ()
  (dolist (base '(1024 1000))
    (let ((dired-eza-size-base base))
      (should (= (dired-eza-size-category "0" nil) 0))
      (cl-loop for category from 1 to 4 for threshold = (expt base category) do
               (should (= (dired-eza-size-category (number-to-string (1- threshold)) nil)
                          (1- category)))
               (should (= (dired-eza-size-category (number-to-string threshold) nil) category)))
      (should (= (dired-eza-size-category "999999999999999999999999999" nil) 4)))))

(ert-deftest dired-eza-size-human-categories ()
  (dolist (case '(("123" "B" 0) ("1.5" "K" 1) ("1,5" "k" 1)
                  ("1024" "K" 1) ("1" "MiB" 2) ("2.3" "G" 3)
                  ("99" "TB" 4) ("3" "PiB" 4)))
    (should (= (dired-eza-size-category (nth 0 case) (nth 1 case)) (nth 2 case))))
  (dolist (case '(("1.2" nil) ("1,234" nil) ("-1" nil) ("NaN" "K")
                  ("2" "garbage") ("1" "m")))
    (should-not (dired-eza-size-category (car case) (cadr case)))))

(ert-deftest dired-eza-size-umbrella-order-and-resets ()
  (let ((rules (dired-eza-size-parse "sn=31:nk=32:sb=33:um=34:ur=35")))
    (should (= (length rules) 10))
    (should (equal (cdr (assoc "nb" rules)) '(:foreground "#800000")))
    (should (equal (cdr (assoc "nk" rules)) '(:foreground "#008000")))
    (should (equal (cdr (assoc "um" rules)) '(:foreground "#000080"))))
  (should (equal (cdr (assoc "nk" (dired-eza-size-parse "nk=32:sn=31")))
                 '(:foreground "#800000")))
  (should (equal (cdr (assoc "nb" (dired-eza-size-parse "sn=31:reset:nk=32")))
                 dired-eza-colors--reset))
  (should (equal (cdr (assoc "nk" (dired-eza-size-parse "nk=32:nk=bad")))
                 '(:foreground "#008000"))))

(ert-deftest dired-eza-size-font-lock-raw-and-human ()
