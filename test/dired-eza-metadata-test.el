(require 'dired-eza-test-helper)

(ert-deftest dired-eza-metadata-keys-and-reset ()
  (let ((rules (dired-eza-metadata-parse "uu=31:uR=32:un=33:gu=34:gR=35:gn=36:da=37:di=31")))
    (should (= (length rules) 7))
    (should-not (assoc "di" rules)))
  (should (equal (cdr (assoc "da" (dired-eza-metadata-parse "da=31:da=bad")))
                 '(:foreground "#800000")))
  (should (equal (cdr (assoc "uu" (dired-eza-metadata-parse "reset:da=32")))
                 dired-eza-colors--reset)))

(ert-deftest dired-eza-metadata-identity-categories ()
  (let ((identity '(:users ("me" "1000") :groups ("staff" "20")
                   :root-users ("root" "0") :root-groups ("wheel" "0")))
        (rules (dired-eza-metadata-parse "uu=31:uR=32:un=33:gu=34:gR=35:gn=36:da=37")))
    (dolist (case '((owner "me" "#800000") (owner "1000" "#800000")
                    (owner "root" "#008000") (owner "0" "#008000")
                    (owner "someone" "#808000") (group "staff" "#000080")
                    (group "20" "#000080") (group "wheel" "#800080")
                    (group "0" "#800080") (group "other" "#008080")
                    (date "Oct 15 12:00" "#c0c0c0")))
      (should (equal (plist-get (car (dired-eza-metadata-face rules identity (car case) (cadr case)))
                                :foreground) (nth 2 case)))))
  ;; Current identity/membership takes precedence over root, as in eza.
  (should (eq (dired-eza-metadata-face nil '(:users ("0") :root-users ("0")) 'owner "0")
              'dired-eza-owner-self)))

(ert-deftest dired-eza-metadata-windows-case-comparison ()
  (should (eq (dired-eza-metadata-face nil '(:users ("DOMAIN\\Alice") :ignore-case t)
                                     'owner "domain\\alice") 'dired-eza-owner-self))
  (should (eq (dired-eza-metadata-face nil '(:users ("Alice")) 'owner "alice")
              'dired-eza-owner-other)))

(ert-deftest dired-eza-metadata-remote-neutral-without-identity-lookups ()
  (let ((dired-eza-user-identities nil) (dired-eza-group-identities nil)
        (native-comp-enable-subr-trampolines nil))
    (cl-letf (((symbol-function 'user-uid) (lambda (&rest _) (ert-fail "uid lookup")))
              ((symbol-function 'group-gid) (lambda (&rest _) (ert-fail "gid lookup")))
              ((symbol-function 'user-login-name) (lambda (&rest _) (ert-fail "username lookup")))
              ((symbol-function 'group-name) (lambda (&rest _) (ert-fail "group lookup"))))
      (let ((identity (dired-eza-metadata-identity t))
            (rules (dired-eza-metadata-parse "un=31:gn=32:uR=33:gR=34")))
        (should (eq (dired-eza-metadata-face rules identity 'owner "root")
                    'dired-eza-owner-other))
        (should (eq (dired-eza-metadata-face rules identity 'group "0")
                    'dired-eza-group-other))))))

(ert-deftest dired-eza-metadata-explicit-remote-identity ()
  (let* ((dired-eza-user-identities '("remote-user" "1001"))
         (dired-eza-group-identities '("remote-group" "2001"))
         (identity (dired-eza-metadata-identity t)))
    (should (eq (dired-eza-metadata-face nil identity 'owner "1001") 'dired-eza-owner-self))
    (should (eq (dired-eza-metadata-face nil identity 'group "remote-group")
                'dired-eza-group-member))))

(ert-deftest dired-eza-metadata-native-font-lock-and-disable ()
  (dired-eza-test--buffer
    (setq-local dired-eza-eza-colors "uu=31:gu=32:da=33")
    (dired-eza-mode 1) (font-lock-ensure)
    (should (equal (dired-eza-test--foreground "owner") "#800000"))
    (should (equal (dired-eza-test--foreground "group") "#008000"))
    (should (equal (dired-eza-test--foreground "Oct 15 12:00") "#808000"))
    (should (equal (dired-eza-test--foreground "notes.txt") "#800000"))
    (dired-eza-mode -1) (font-lock-ensure)
    (should-not (dired-eza-test--face "owner"))
    (should-not (dired-eza-test--face "Oct 15 12:00"))))

(ert-deftest dired-eza-metadata-optional-fields-and-refresh ()
  (dired-eza-test--buffer
    (let ((dired-eza-color-ownership nil) (dired-eza-color-timestamps nil))
      (dired-eza-mode 1) (font-lock-ensure)
      (should-not dired-eza--identity)
      (should-not (dired-eza-test--face "owner"))
      (should-not (dired-eza-test--face "Oct 15 12:00"))
      (setq dired-eza-color-timestamps t)
      (dired-eza-refresh) (font-lock-ensure)
      (should (memq 'dired-eza-timestamp (ensure-list (dired-eza-test--face "Oct 15 12:00"))))
      (should-not (dired-eza-test--face "owner"))
      (setq dired-eza-color-ownership t)
      (setq-local dired-eza-eza-colors "uu=34:da=35")
      (dired-eza-refresh) (font-lock-ensure)
      (should (equal (dired-eza-test--foreground "owner") "#000080"))
      (should (equal (dired-eza-test--foreground "Oct 15 12:00") "#800080")))))

(ert-deftest dired-eza-metadata-omitted-and-ambiguous-columns ()
  (dired-eza-test--buffer
    (cl-loop for case in '(("-alg" "group" group) ("-alo" "owner" owner)
                    ("-alG" "owner" owner) ("-al --no-group" "owner" owner)
                    ("-algo" "" nil) ("-al" "too many name fields" nil)
                    ("-al --author" "owner group" nil)
                    ("-alZ" "owner group" nil))
             for n from 0 do
      (let* ((name (format "layout%d" n))
             (fields nil))
        (dired-eza-test--size-row name "2048" nil nil nil (concat " 1 " (cadr case) " "))
        (goto-char (point-min)) (search-forward name)
        (let ((filename (match-beginning 0)))
          (beginning-of-line)
          (setq fields (dired-eza-metadata-fields (+ (point) 12) filename (car case))))
        (should (= (length fields) (if (nth 2 case) 2 1)))
        (when (nth 2 case)
          (should (eq (nth 2 (car fields)) (nth 2 case)))
          (should (equal (nth 3 (car fields)) (cadr case))))))))

(ert-deftest dired-eza-metadata-device-owners-and-iso-dates ()
  (dired-eza-test--buffer
    (dired-eza-test--size-row "device" "8, 1" "2026-10-15 12:00:00.123 -0500"
                            "  128 8 " "brw-r--r--" " 1 owner group ")
    (setq-local dired-eza-eza-colors "uu=31:gu=32:da=33")
    (dired-eza-mode 1) (font-lock-ensure)
    (should (equal (dired-eza-test--foreground "2026-10-15 12:00:00.123 -0500") "#808000"))
    (should-not (dired-eza-test--size-face "device" "8, 1"))))

(ert-deftest dired-eza-metadata-hidden-rows-and-details ()
  (dired-eza-test--buffer
    (let ((inhibit-read-only t)) (dired-insert-set-properties (point-min) (point-max)))
    (dired-hide-details-mode 1)
    (dired-eza-mode 1) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "owner")
    (should (invisible-p (1- (point))))
    (should (memq 'dired-eza-owner-self (ensure-list (get-text-property (1- (point)) 'face))))
    (let ((inhibit-read-only t))
      (put-text-property (line-beginning-position) (line-end-position) 'invisible 'dired))
    (dired-eza-refresh) (font-lock-ensure)
    (should-not (dired-eza-test--face "owner"))))

(ert-deftest dired-eza-metadata-does-not-query-identity-while-fontifying ()
  (dired-eza-test--buffer
    (dired-eza-mode 1)
    (let ((native-comp-enable-subr-trampolines nil))
      (cl-letf (((symbol-function 'group-name) (lambda (&rest _) (ert-fail "group lookup")))
                ((symbol-function 'user-login-name) (lambda (&rest _) (ert-fail "user lookup"))))
        (font-lock-ensure)
        (should (memq 'dired-eza-owner-self (ensure-list (dired-eza-test--face "owner"))))))))

(provide 'dired-eza-metadata-test)
